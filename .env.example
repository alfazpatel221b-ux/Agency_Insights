# Agency Insights — local/deployment environment variables
# Never commit your real .env file.

# Firebase Web App configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=agency-insights-508217.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agency-insights-508217
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
